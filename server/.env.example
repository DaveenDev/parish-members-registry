API_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parishdb
JWT_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_EMAIL=admin@parishregistry.org
SEED_ADMIN_PASSWORD=ParishAdmin123!

# Comma-separated list of browser origins allowed to call the API.
# Leave blank for same-origin deployments and local dev (Vite proxies /api).
# Example: CORS_ORIGIN=https://registry.example.org
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Production only — set these in the host's dashboard, not in a committed file.
# ---------------------------------------------------------------------------
# NODE_ENV=production turns on the production guards: the server refuses to
# start without a real JWT_SECRET, db:setup refuses the default admin password,
# and db:reset/db:demo require --i-know-this-is-production.
# NODE_ENV=production

# TLS to the database. Auto-detected — on for remote hosts, off for localhost.
# Override only if your provider needs it: require | no-verify | disable
# PGSSLMODE=require

# Postgres connections to hold open. Keep low on Supabase's free pooler.
# PGPOOL_MAX=5
