VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# The PRO notes (tip cards, the monthly showcase and Settings → PRO modules).
# Off unless set to "on", so existing parishes see nothing until PRO is ready.
# Set it in Vercel and redeploy; it's built into the page, so it isn't a secret.
# VITE_PRO_PROMO=on

# Demo site only (deploy/02-demo.md): the shared Demo access login behind
# "Login to Demo Site" on the staff sign-in page. Never set on the live site.
# VITE_DEMO_EMAIL=
# VITE_DEMO_PASSWORD=
