# Where the API lives. Leave blank for local dev and for single-host
# deployments — the Vite dev server proxies /api to localhost:4000.
#
# Set this when the client is hosted separately from the API (Vercel + Render).
# Origin only, no trailing /api — the client appends that itself.
# VITE_API_BASE=https://parish-registry-api.onrender.com
VITE_API_BASE=
