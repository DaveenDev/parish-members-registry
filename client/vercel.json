{
  "rewrites": [
    {
      "source": "/media/:path*",
      "has": [{ "type": "host", "value": { "pre": "sjmvparish" } }],
      "destination": "https://pub-d7240a77736f4c31a6534c5e623c6d61.r2.dev/:path*"
    },
    { "source": "/media/:path*", "destination": "https://pub-d7240a77736f4c31a6534c5e623c6d61.r2.dev/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/((?!api/|assets/|media/|icons/|admin|census|register|sitemap|robots|favicon|sw\\.js).*)",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|meta-externalagent|Twitterbot|WhatsApp|TelegramBot|Slackbot|LinkedInBot|Discordbot|Viber|SkypeUriPreview|Pinterest|redditbot|Embedly).*" }],
      "destination": "/api/share?path=/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(admin|census)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "sjmvparish" } }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
