{
  "rewrites": [
    {
      "source": "/media/:path*",
      "has": [{ "type": "host", "value": { "pre": "olgqp-training" } }],
      "destination": "https://pub-93600e56fb724c9c8fdf449acb86fcf7.r2.dev/:path*"
    },
    { "source": "/media/:path*", "destination": "https://pub-25d83e20c5f14fc0b2f81d3476651579.r2.dev/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
