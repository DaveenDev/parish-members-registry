{
  "name": "parish-members-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parish Members Online Registry — public registration wizard + admin panel",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm run dev --prefix client",
    "start": "node server/src/server.js",
    "build": "npm run build --prefix client",
    "db:setup": "node server/src/db/setup.js",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
