{
  "name": "parish-members-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Parish Members Online Registry — public registration wizard + admin panel",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "db:demo": "node scripts/supabase-seed.mjs demo",
    "db:reset": "node scripts/supabase-seed.mjs reset",
    "install:all": "npm install && npm install --prefix client",
    "test": "node --test \"client/test/**/*.test.js\"",
    "test:watch": "node --test --watch \"client/test/**/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.5"
  }
}
